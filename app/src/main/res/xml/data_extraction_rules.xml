<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Excluye todo el almacenamiento de la copia de seguridad en la nube de Google -->
        <exclude path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Excluye todo el almacenamiento de transferencias directas entre dispositivos -->
        <exclude path="." />
    </device-transfer>
</data-extraction-rules>
